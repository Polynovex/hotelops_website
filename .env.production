# Production build configuration.
#
# Vite inlines VITE_* variables at BUILD time, so this file must be present
# when `npm run build` runs — setting the variable in a hosting dashboard only
# works if the site is rebuilt afterwards. Committing it here means a
# production build is correct by default.
#
# A Vercel/host environment variable of the same name still takes precedence.
VITE_API_URL=https://upgrbihy03.execute-api.us-east-2.amazonaws.com/api
